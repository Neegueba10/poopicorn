{
  "name": "js13k2026-poppicorn",
  "version": "1.0.0",
  "description": "Poopicorn — a js13kGames 2026 entry (theme: Rainbows and Unicorns)",
  "main": "src/js/game.js",
  "scripts": {
    "clean": "rm -rf dist && mkdir dist",
    "build": "run-s clean build:*",
    "build:js": "rollup -c scripts/rollup.config.js --environment MINIFY",
    "build:props": "node scripts/crunch-props.js",
    "build:roadroller": "roadroller dist/game-rollup.js -Zab21 -Zlr1669 -Zmc3 -Zmd61 -Zpr16 -S0,1,2,3,5,6,13,42,49,109,402,449 -o dist/game.js",
    "-build:roadroller": "roadroller dist/game-rollup.js -O2 -o dist/game.js",
    "build:html": "node scripts/inline-html.js | html-minifier-terser -c scripts/htmlmin.json -o dist/index.html",
    "build:zip": "zip -FS -qjX9 dist/game.zip dist/index.html && advzip -z -4 -i 4000 dist/game.zip && ect -9 -zip dist/game.zip",
    "build:zipSize": "node scripts/zipSize.js",
    "start": "npm-run-all -s clean -p dev:*",
    "dev:js": "rollup -c scripts/rollup.config.js -w --environment DEBUG --output.file dist/game.js",
    "dev:serve_watch_html_js": "browser-sync 'dist' 'src' --watch --host 0.0.0.0 --https --no-open",
    "find-roadroller-config": "echo 3600 | node scripts/find-best-roadroller.js",
    "tools": "node tools/server.js",
    "convert-song": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/convert-song.mjs",
    "test": "node tests/run.mjs",
    "test:dist": "node tests/smoke-dist.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@wwa/rollup-plugin-terser": "^1.1.2",
    "browser-sync": "^3.0.3",
    "html-minifier-terser": "^7.2.0",
    "npm-run-all": "^4.1.5",
    "roadroller": "^2.1.0",
    "rollup": "^2.23.0",
    "terser": "^5.40.0"
  },
  "author": "Ryan Malm"
}
